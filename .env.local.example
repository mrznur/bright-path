# ── Neon Postgres ────────────────────────────────────────────────────────────
# Get this from your Neon project dashboard → Connection Details
# Example: postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/brightpath?sslmode=require

# ── Admin auth ───────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
ADMIN_JWT_SECRET=replace_with_a_long_random_string
ADMIN_EMAIL=admin@brightpath.com
ADMIN_PASSWORD=change_this_password
